{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": { "includeFiles": "{content,lib,public/assets}/**" }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?__p=/$1" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] }
  ]
}
